/*
 * IconFlowNative.rc
 * Windows resource script for IconFlow Native Picker (.aex)
 *
 * Includes:
 *   1. The compiled PiPL binary (IconFlowNative.rr) generated by PiPLtool.exe.
 *      PiPLtool is invoked by the build scripts before compiling this file.
 *   2. Standard VS_VERSION_INFO for the DLL.
 *
 * Build order (handled by configure_windows.ps1 / build_release.ps1):
 *   Step 1: PiPLtool.exe pipl\IconFlowNative.r > src\IconFlowNative.rr
 *   Step 2: rc.exe compiles this .rc (which #includes the .rr)
 *   Step 3: cl.exe / link.exe builds the .dll, renamed to .aex
 */

#include "windows.h"

/* ── PiPL binary resource ──────────────────────────────────────────────────
 * IconFlowNative.rr is generated by PiPLtool from pipl/IconFlowNative.r.
 * If it is missing, run configure_windows.ps1 first.
 */
#include "IconFlowNative.rr"

/* ── Version information ─────────────────────────────────────────────────── */
VS_VERSION_INFO VERSIONINFO
    FILEVERSION    1, 5, 0, 0
    PRODUCTVERSION 1, 5, 0, 0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_DLL
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "IconFlow\0"
            VALUE "FileDescription",  "IconFlow Native Picker — After Effects Effect\0"
            VALUE "FileVersion",      "1.5.0.0\0"
            VALUE "InternalName",     "IconFlowNative\0"
            VALUE "LegalCopyright",   "\xA9 IconFlow 2024\0"
            VALUE "OriginalFilename", "IconFlowNative.aex\0"
            VALUE "ProductName",      "IconFlow Native Picker\0"
            VALUE "ProductVersion",   "1.5.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
